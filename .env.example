# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Database (Phase 6+)
# Shared Pooler URLs from Supabase Connect. URL-encode password special chars (+ → %2B).
# DATABASE_URL = transaction mode :6543?pgbouncer=true&connection_limit=1&sslmode=require
# DIRECT_URL   = session mode :5432?sslmode=require (IPv4; direct host is IPv6-only)
DATABASE_URL=
DIRECT_URL=

# Supabase (Phase 3+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# AI (Phase 7+)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security (Phase 9+)
# 32+ char random string. Encrypts platform tokens and signs OAuth state.
TOKEN_ENCRYPTION_SECRET=

# Supabase Storage (Phase 7/8) — server-only, used to upload generated media.
SUPABASE_STORAGE_BUCKET=media

# Google OAuth — App SSO (Phase 3+)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Publishing (Phase 9+)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# TikTok Publishing (Phase 9+)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# LinkedIn Publishing (Phase 9+)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Facebook Publishing (Phase 9+)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# Web Push (Phase 4+)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
