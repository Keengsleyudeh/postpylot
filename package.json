{
  "name": "postpylot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @postpylot/web",
    "build": "npm run build -w @postpylot/web",
    "lint": "npm run lint -w @postpylot/web",
    "typecheck": "npm run typecheck -w @postpylot/web",
    "start": "npm run start -w @postpylot/web",
    "db:generate": "npm run generate -w @postpylot/db",
    "db:migrate": "npm run migrate -w @postpylot/db",
    "db:push": "npm run push -w @postpylot/db",
    "db:studio": "npm run studio -w @postpylot/db"
  },
  "engines": {
    "node": ">=20"
  }
}
