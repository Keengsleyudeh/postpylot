# Prisma CLI reads these when running migrations (npm run db:migrate / db:studio).
# Copy to packages/db/.env and fill with your Supabase Postgres credentials.
# Get them from https://supabase.com/dashboard/project/_/settings/database → Connect
#
# Use Shared Pooler (IPv4). Direct db.*.supabase.co is IPv6-only on free tier.
# URL-encode special characters in the password (e.g. + → %2B, @ → %40).
#
# DATABASE_URL = Transaction mode (port 6543) + ?pgbouncer=true&connection_limit=1&sslmode=require
# DIRECT_URL   = Session mode (port 5432) + ?sslmode=require
DATABASE_URL=
DIRECT_URL=
